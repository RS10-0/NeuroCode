# Backend environment
#
# Copy to server/.env and fill in. Everything here stays on the
# server — none of it is ever sent to the browser.
#
# Nothing in this file may be given a VITE_ prefix or copied into
# the root .env.local. Vite inlines VITE_* into the JavaScript
# bundle it ships, so a provider key placed there would be
# readable by anyone who opens devtools.

# Supabase, service role. Bypasses RLS: keep it secret.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# HTTP
PORT=3001
NEUROLINK_ALLOWED_ORIGINS=http://localhost:5173


# =========================================================
# PUBLIC ADDRESSES
#
# Two different origins, and genuinely two different things
# rather than a duplicate.
#
# The API one is where a deployed agent's endpoint answers —
# what the Deploy screen prints into its curl example. The
# SITE one is where a browser loads a published page, and is
# what a student copies and hands to somebody else.
#
# In development these are two ports; in production they may
# be two hosts. The server cannot infer either from a request
# it has not received yet, so both fall back to localhost —
# right on this machine and obviously wrong in production,
# where they are meant to be set.
#
# Leaving NEUROLINK_PUBLIC_SITE_URL unset in production is the
# one that bites quietly: nothing breaks, and every student
# copies a localhost link that works only for them.
# =========================================================

# NEUROLINK_PUBLIC_API_URL=https://api.buildgentic.com
# NEUROLINK_PUBLIC_SITE_URL=https://buildgentic.com

# =========================================================
# THE PROVIDER CASCADE
#
# Every AI request walks this list from the top, on every
# single call:
#
#   1. Groq        fastest first token
#   2. Cloudflare  Workers AI; free allowance is a daily budget
#   3. OpenRouter  brokered, reaches many model families
#   4. Mistral     last resort
#
# If one is rate-limited, erroring, or already at its window,
# the next one answers — inside the same request, with no
# "try again later" reaching the learner. The moment a
# higher-priority provider frees up, the next request uses it
# again: nothing is pinned to a user or a session.
#
# Configure as many or as few as you like. With NONE of them
# set the runtime falls back to a deterministic offline mock:
# the Lab, streaming, quotas and usage recording all still
# work, they simply never leave the machine. That fallback is
# what makes a fresh clone runnable.
#
# Priority, models and rate windows live in
# server/src/ai/providerChain.ts — reordering the cascade is an
# edit to that array and nothing else.
# =========================================================

# https://console.groq.com/keys
NEUROLINK_GROQ_API_KEY=

# Cloudflare Workers AI.
#
# Needs TWO variables, not one: the endpoint is per account, so
# the account id is part of the URL rather than part of the auth.
# With the token set and the account id missing, Cloudflare is
# held out of the cascade entirely and the startup banner says
# so — it is not silently skipped.
#
# Account id:  https://dash.cloudflare.com  (Workers & Pages -> AI)
# API token:   https://dash.cloudflare.com/profile/api-tokens
#              needs the "Workers AI" read permission.
NEUROLINK_CLOUDFLARE_ACCOUNT_ID=
NEUROLINK_CLOUDFLARE_API_TOKEN=

# https://openrouter.ai/keys
# NEUROLINK_FREE_API_KEY is accepted as an alias, for continuity
# with older .env files.
NEUROLINK_OPENROUTER_API_KEY=
NEUROLINK_OPENROUTER_REFERER=http://localhost:5173
NEUROLINK_OPENROUTER_TITLE=BuildGentic

# https://console.mistral.ai/api-keys
NEUROLINK_MISTRAL_API_KEY=

# ---------------------------------------------------------
# MODEL IDS AND RATE WINDOWS
#
# Every one of these overrides a default in providerChain.ts.
# Vendors retire model ids on their own schedule, so confirm
# the defaults before going live:
#
#   npx tsx ./scripts/probe-providers.mts
#
# The RPM/TPM numbers are what BuildGentic uses to skip a
# provider BEFORE asking it, rather than discovering the
# ceiling by eating a 429. Set them a little under each
# provider's published limit. Zero disables that check.
# ---------------------------------------------------------

# NEUROLINK_GROQ_MODEL=llama-3.3-70b-versatile
# NEUROLINK_GROQ_RPM=28
# NEUROLINK_GROQ_TPM=5500

# Cloudflare's free allowance is 10,000 neurons PER DAY rather
# than a per-minute ceiling, and one gpt-oss-120b answer costs
# roughly 6-7 of them. The RPM default is therefore set to pace
# that daily budget, not to track Cloudflare's own ~300/min text
# limit. TPM is 0 because Cloudflare publishes no per-minute
# token ceiling to be conservative about.
#
# Part of Cloudflare's catalogue needs a paid Workers plan even
# though it is listed — asking for one returns 403 code 5035. The
# Kimi, GLM and DeepSeek-V4 families are gated this way; the
# gpt-oss and Llama families are not.
# NEUROLINK_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# NEUROLINK_CLOUDFLARE_RPM=60
# NEUROLINK_CLOUDFLARE_TPM=0

# OpenRouter's model must be a ":free" id unless the account has
# purchased credits — a paid id on a free-tier key returns 402 on
# every request, which the cascade hides by falling through.
#
# That free list ROTATES, often weekly, and ids get delisted with
# little notice. `npx tsx ./scripts/probe-providers.mts` is what
# catches a stale one; run it if slot 3 seems never to serve.
#
# The free allowance is a daily REQUEST count, not a token rate:
# 50/day on a key that has never topped up, 1,000/day after a
# one-time $10 credit purchase.
#
# Avoid openrouter/free (the Free Models Router). It picks a free
# model at random per request, and it was measured returning an
# empty answer once in five calls and a 16s first token once —
# both are worse for the cascade than a stale pinned id.
# NEUROLINK_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# NEUROLINK_OPENROUTER_RPM=18

# NEUROLINK_MISTRAL_MODEL=mistral-small-latest
# NEUROLINK_MISTRAL_RPM=55


# =========================================================
# EMBEDDINGS
#
# Knowledge retrieval and agent memory need vectors, and none
# of the four cascade providers serves an embeddings endpoint
# that fits the existing 768-dimension columns. So embeddings
# are resolved separately from chat and do NOT go through the
# cascade.
# =========================================================

# From https://aistudio.google.com/apikey
NEUROLINK_GEMINI_API_KEY=


# ---------------------------------------------------------
# PER-USER QUOTAS — platform power source
#
# Server-enforced, counted in the database, unaffected by
# anything the browser does. These stop ONE learner looping.
# They are not a budget: see the platform ceiling below.
#
# A zero disables that particular limit. Useful in development;
# do not ship one.
# ---------------------------------------------------------

NEUROLINK_AI_REQUESTS_PER_MINUTE=12
NEUROLINK_AI_REQUESTS_PER_DAY=200
NEUROLINK_AI_MAX_CONCURRENT=3
NEUROLINK_AI_MAX_INPUT_CHARS=24000
NEUROLINK_AI_MAX_OUTPUT_TOKENS=1024
# The limit that actually tracks money. Counting requests treats
# a 20-token turn and a 6,000-token turn as equal.
NEUROLINK_AI_TOKENS_PER_DAY=60000


# ---------------------------------------------------------
# PLATFORM BUDGET — the ceiling on BuildGentic's own bill
#
# Counted across EVERY learner, not per learner. This is the
# only thing that bounds what the platform can be charged:
# per-user limits multiply by the number of accounts, and the
# number of accounts is not bounded.
#
# Counts platform traffic only. BYOK requests are the learner's
# own spend and are tracked separately.
#
# Daily is a rolling 24 hours (abuse control); monthly is a
# calendar month (matches a provider invoice).
# ---------------------------------------------------------

NEUROLINK_AI_PLATFORM_DAILY_REQUESTS=2000
NEUROLINK_AI_PLATFORM_DAILY_TOKENS=200000
NEUROLINK_AI_PLATFORM_MONTHLY_REQUESTS=40000
NEUROLINK_AI_PLATFORM_MONTHLY_TOKENS=4000000

# ---------------------------------------------------------
# GLOBAL PER-USER CEILING
#
# The cap no single account may exceed on any power source,
# whoever is paying. The abuse limit rather than the budget one.
# ---------------------------------------------------------

NEUROLINK_AI_CEILING_REQUESTS_PER_MINUTE=90
NEUROLINK_AI_CEILING_REQUESTS_PER_DAY=5000
NEUROLINK_AI_CEILING_MAX_CONCURRENT=8
NEUROLINK_AI_CEILING_MAX_INPUT_CHARS=120000
NEUROLINK_AI_CEILING_MAX_OUTPUT_TOKENS=8192
NEUROLINK_AI_CEILING_TOKENS_PER_DAY=4000000

# ---------------------------------------------------------
# REQUEST SHAPE
# ---------------------------------------------------------

NEUROLINK_AI_MAX_MESSAGES=40
NEUROLINK_AI_MAX_MESSAGE_CHARS=12000
NEUROLINK_AI_MAX_SYSTEM_CHARS=8000

# ---------------------------------------------------------
# TIMEOUTS
#
# FIRST_TOKEN is the shorter one on purpose: a provider that
# accepts the connection and then says nothing is the commonest
# way a request hangs, and it deserves a faster failure than the
# whole-request budget.
# ---------------------------------------------------------

NEUROLINK_AI_TIMEOUT_MS=60000
NEUROLINK_AI_FIRST_TOKEN_TIMEOUT_MS=25000

# ---------------------------------------------------------
# KNOWLEDGE RETRIEVAL
#
# How an agent's knowledge is cut up, how much of it comes back
# for a question, and how much of that reaches the model.
#
# Every one of these is a trade rather than a correct value.
# Bigger chunks carry more context and match less precisely. A
# higher top-K finds more and dilutes more. A higher similarity
# floor says "I do not know" more often and guesses less. They
# are configuration for exactly that reason.
# ---------------------------------------------------------

# Target size of one searchable passage, and how much of the
# previous one is repeated at the start of the next. The overlap
# is what stops a fact that straddles a boundary from ending up
# usable in neither piece.
NEUROLINK_KNOWLEDGE_CHUNK_CHARS=900
NEUROLINK_KNOWLEDGE_CHUNK_OVERLAP=150

# How many passages one question may pull back.
NEUROLINK_RETRIEVAL_TOP_K=6

# The similarity a passage must reach to be sent at all, as a
# whole number of percent on a 0-100 cosine scale. This is the
# setting that makes "your knowledge does not cover that" a real
# answer: without a floor, every question retrieves the six
# least-irrelevant passages in the library.
#
# 60 is measured, not guessed, and it is worth knowing why it is
# so high. Embedding similarity is not an intuitive scale --
# nothing is ever near zero, because any two pieces of English
# prose have a great deal in common compared to random noise. On
# a corpus of four unrelated subjects, gemini-embedding-001 at
# 768 dimensions scored questions against their OWN subject at
# 0.695-0.791 and questions about something else entirely (a
# rhyme, a recipe, a CSS problem) at 0.480-0.549 against their
# best match. This sits in the middle of that gap.
#
# The middle rather than the edge, and that was learned the hard
# way: 55 looked safe against the same measurements and still
# let an off-topic question through, because the highest
# irrelevant score landed 0.001 below it.
#
# Re-measure this if you change the embedding model. Different
# models have entirely different scales, and a floor tuned for
# one is meaningless on another.
NEUROLINK_RETRIEVAL_MIN_SIMILARITY=60

# A second floor, relative to the best match a question found,
# as a percentage of it. The absolute floor above decides
# whether the agent knows anything about the question; this
# decides how much of the tail is worth sending once it does.
#
# A question with a 0.79 match and a 0.58 match has found one
# passage that answers it and one that merely shares its
# vocabulary. Keeping anything within 80% of the best match
# keeps genuine runners-up -- a document split across two
# chunks scores both at nearly the same level -- and drops the
# rest. Set to 0 to disable.
NEUROLINK_RETRIEVAL_RELATIVE_FLOOR=80

# The ceiling on retrieved text in one prompt. ADDITIONAL to
# NEUROLINK_AI_MAX_SYSTEM_CHARS rather than carved out of it, so
# turning retrieval on never shrinks the space an agent's own
# instructions get. Both together stay well inside
# NEUROLINK_AI_MAX_INPUT_CHARS.
NEUROLINK_RETRIEVAL_CONTEXT_CHARS=4000

# How many passages one indexing request will embed before
# handing back and asking to be called again. Indexing is
# synchronous; this is what stops a large paste from becoming a
# request that runs until a proxy gives up on it.
NEUROLINK_INDEX_MAX_CHUNKS_PER_REQUEST=200

# Whole-request budget for one embedding call.
NEUROLINK_EMBED_TIMEOUT_MS=30000

# ---------------------------------------------------------
# EMBEDDING QUOTAS
#
# Embeddings are model calls, so they are counted -- and counted
# in their OWN windows, under the quota key `embed:<source>:<user>`.
#
# Separate because a retrieval-backed turn is two calls, one to
# embed the question and one to answer it. Charging both to the
# per-minute window a learner uses for the Lab would halve what
# they can do the moment they switch the capability on, and
# nobody should be rate-limited out of their own Lab by an agent
# looking something up.
#
# Separate windows, not an exemption. These are still atomic,
# still enforced in SQL, still written to ai_usage, and -- on the
# platform power source -- still inside the platform budget
# above, which counts by power source rather than by quota key.
#
# Which key pays follows the AGENT's power source: a platform
# agent embeds on BuildGentic's key, a BYOK agent on its owner's.
# Anthropic and OpenRouter publish no embeddings API, so an owner
# whose only connected key is one of those cannot index -- their
# knowledge keeps being sent in full, exactly as before.
# ---------------------------------------------------------

NEUROLINK_EMBED_REQUESTS_PER_MINUTE=60
NEUROLINK_EMBED_REQUESTS_PER_DAY=600
NEUROLINK_EMBED_MAX_CONCURRENT=4
NEUROLINK_EMBED_MAX_INPUT_CHARS=60000
NEUROLINK_EMBED_TOKENS_PER_DAY=400000


# ---------------------------------------------------------
# WEB SEARCH
#
# The capability that lets an agent look something up on the
# live web when a question needs current information.
#
# It is not a second AI system. The agent decides whether to
# search with one small call through the same runtime, the
# search itself goes through the same quota gate and lands in
# the same ai_usage ledger, and the results are appended to the
# prompt by the same code path that appends retrieved knowledge
# -- so an agent searches identically in the Builder's Test
# panel and behind a deployed endpoint.
#
# Which provider answers. DuckDuckGo is the default and needs
# NO KEY, which is what makes this capability work on a fresh
# clone. It is also the least stable of the three: it parses a
# public HTML page, so a layout change makes it return nothing,
# which degrades to "found nothing" rather than to an error.
#
# `brave` and `tavily` return structured JSON and publication
# dates and are what a real deployment should use -- set the
# matching key below and name the provider here. `mock` forces
# an offline corpus, which never leaves the machine and is what
# the verification suite uses to assert on ranking without
# depending on what the web says today.
#
# Naming a keyed provider without its key falls back to `mock`
# rather than failing, and says so loudly at startup.
# ---------------------------------------------------------

NEUROLINK_WEB_SEARCH_PROVIDER=duckduckgo

# From https://brave.com/search/api/ -- free tier, no card.
NEUROLINK_BRAVE_SEARCH_KEY=

# From https://tavily.com -- built for LLM use; returns extracted
# page content rather than a marketing snippet.
NEUROLINK_TAVILY_API_KEY=

# How many separate questions one turn may ask the web, and how
# long one of them may be. Two queries because a question often
# has two halves ("compare X and Y"); not five, because each is
# a round trip a learner waits through.
NEUROLINK_WEB_SEARCH_MAX_QUERIES=2
NEUROLINK_WEB_SEARCH_QUERY_CHARS=200

# Results per query, results per turn after duplicates are
# merged, and how much of one result's description reaches the
# model. BuildGentic never fetches the pages themselves -- see
# server/src/search/types.ts on why -- so the snippet is the
# whole of what the agent gets to read per source.
NEUROLINK_WEB_SEARCH_RESULTS_PER_QUERY=5
NEUROLINK_WEB_SEARCH_MAX_RESULTS=6
NEUROLINK_WEB_SEARCH_SNIPPET_CHARS=500

# The ceiling on web results in one prompt. ADDITIONAL to
# NEUROLINK_AI_MAX_SYSTEM_CHARS, exactly like the retrieval
# budget, so switching this on never shrinks the space an
# agent's own instructions get. Instructions, retrieved
# knowledge and web results together stay inside
# NEUROLINK_AI_MAX_INPUT_CHARS, and anything that does not fit
# is dropped rather than truncated.
NEUROLINK_WEB_SEARCH_CONTEXT_CHARS=4000

# Whole-request budget for one search provider call.
NEUROLINK_WEB_SEARCH_TIMEOUT_MS=12000

# The decision call: the small model call that reads the
# question and answers "should this be looked up, and what
# would you type into a search box?". It writes one line of
# JSON, sees the last few turns, and sees this much of the
# agent's own instructions so it knows what the agent is for.
NEUROLINK_WEB_SEARCH_PLAN_TOKENS=400
NEUROLINK_WEB_SEARCH_PLAN_TURNS=4
NEUROLINK_WEB_SEARCH_PLAN_INSTRUCTION_CHARS=1500

# ---------------------------------------------------------
# WEB SEARCH QUOTAS
#
# Searching is counted, and counted in its OWN windows, under
# the quota key `search:<power source>:<user id>`.
#
# Separate for the reason embeddings are separate: a
# search-backed turn is three calls -- decide, search, answer --
# and charging all three to the per-minute window a learner uses
# for the Lab would cut what they can do to a third the moment
# they switch the capability on.
#
# Separate windows, not an exemption. Still atomic, still
# enforced in SQL, still written to ai_usage, and -- on the
# platform power source -- still inside the platform budget
# above. Search rows report zero tokens, honestly: no model ran,
# so it is the request windows that bound them.
#
# A deployed agent's searches are deliberately NOT charged to
# the deployment's own windows: the request that provoked them
# already took a slot there, and counting them twice would
# quietly redefine "20 requests a minute" as "seven, if the
# agent searches".
# ---------------------------------------------------------

NEUROLINK_WEB_SEARCH_REQUESTS_PER_MINUTE=60
NEUROLINK_WEB_SEARCH_REQUESTS_PER_DAY=600
NEUROLINK_WEB_SEARCH_MAX_CONCURRENT=4
NEUROLINK_WEB_SEARCH_MAX_INPUT_CHARS=24000
NEUROLINK_WEB_SEARCH_MAX_OUTPUT_TOKENS=512
NEUROLINK_WEB_SEARCH_TOKENS_PER_DAY=200000


# ---------------------------------------------------------
# DEPLOYED AGENTS
#
# A deployed agent answers applications outside BuildGentic, so it
# gets a ceiling of its own on top of its owner's.
#
# These are ADDITIONAL, not alternative. A deployed request is
# still counted against the owner's per-user quota and, on the
# platform power source, still counted against the platform
# budget above -- the owner is still who pays. What these bound
# is one endpoint, so an integration stuck in a retry loop cannot
# spend a learner's whole day before they notice.
#
# Deliberately below the per-user platform allowance, so the
# deployment runs out before the learner does.
# ---------------------------------------------------------

NEUROLINK_DEPLOYMENT_REQUESTS_PER_MINUTE=20
NEUROLINK_DEPLOYMENT_REQUESTS_PER_DAY=500
NEUROLINK_DEPLOYMENT_MAX_CONCURRENT=4

# The origin external callers reach this API at. Shown on the
# Deploy screen and pasted into the curl example there, so it has
# to be the address somebody else's server would use -- which
# this process cannot infer from a request it has not received.
# Defaults to http://localhost:<PORT>, which is right in
# development and obviously wrong anywhere else.
#
# NEUROLINK_PUBLIC_API_URL=https://api.buildgentic.com

# ---------------------------------------------------------
# PUBLISHED PAGE LIMITS
#
# A published page — buildgentic.com/studybuddy — answers
# strangers who present no credential at all, which is one step
# further out than a deployment and gets a correspondingly
# tighter ceiling.
#
# The difference is not really about volume, it is about who is
# on the other end. A deployment key goes to somebody its owner
# chose to give it to; a page URL goes wherever it is forwarded.
# So the failure mode is different too — not a retry loop, but a
# link that travels further than its author expected on an
# afternoon they are not watching.
#
# ADDITIONAL, exactly as the deployment limits are. A page
# request is still counted against the owner's per-user quota,
# still counted against the platform budget when it is
# platform-powered, and still counted in the deployment's own
# windows. The owner still pays; these only bound one door.
# ---------------------------------------------------------

NEUROLINK_SITE_REQUESTS_PER_MINUTE=10
NEUROLINK_SITE_REQUESTS_PER_DAY=200
NEUROLINK_SITE_MAX_CONCURRENT=3

# How much conversation a visitor may send back with each turn.
# Below the runtime's own message ceiling on purpose: a long
# transcript is a large prompt, and a large prompt on a page
# anybody can open is the cheapest way to spend somebody else's
# tokens. The page trims to match, so a long conversation loses
# its oldest turns rather than being refused.
NEUROLINK_SITE_MAX_MESSAGES=20

# Requests per minute from ONE visitor, held in memory rather
# than in the database.
#
# The limits above are per PAGE, which is what protects the
# owner's allowance; this one is per CALLER, and it is what
# stops a single script consuming the whole page ceiling in ten
# seconds and locking out the actual readers. In memory because
# it has to be checked before any work happens — a database
# round trip per request to protect against a flood is a flood
# amplifier. It resets when the process restarts, which is an
# accepted weakness: the per-page ceiling is what bounds spend,
# and this only decides who gets it.
NEUROLINK_SITE_VISITOR_PER_MINUTE=6

# ---------------------------------------------------------
# NATURAL-LANGUAGE PAGE EDITS
#
# "Make the background darker", turned into a field change by
# one small model call. Its own quota window, the same shape Web
# Search has and for the same reason: designing a page is a
# second call on top of whatever else the student is doing, and
# charging it to their chat window would mean laying out a page
# eats the allowance for testing the agent it is a page for.
# ---------------------------------------------------------

NEUROLINK_SITE_EDIT_REQUESTS_PER_MINUTE=10
NEUROLINK_SITE_EDIT_REQUESTS_PER_DAY=120
NEUROLINK_SITE_EDIT_MAX_CONCURRENT=2
NEUROLINK_SITE_EDIT_MAX_INPUT_CHARS=24000

# The call returns a list of field operations, not a page, so it
# is small — but a request that rewrites an FAQ returns every
# item. Below roughly this, the model truncates mid-JSON and the
# student is told their answer was cut off, which is a confusing
# way to learn they asked for too much at once.
NEUROLINK_SITE_EDIT_MAX_OUTPUT_TOKENS=1500
NEUROLINK_SITE_EDIT_TOKENS_PER_DAY=150000

# What a student may type in one request. Long enough for a
# paragraph describing several changes, short enough that the
# prompt stays dominated by the page rather than by the request.
NEUROLINK_SITE_EDIT_MAX_REQUEST_CHARS=600


# =========================================================
# THE SECRET KEY
#
# Encrypts agent connection credentials at rest, with
# AES-256-GCM. Nothing else uses it.
#
# Required only if agents are to hold credentials. Without it
# the sandbox and public GET requests both still work, and the
# Builder says plainly that a connection with a key cannot be
# saved — a configuration problem shown to the person who can
# fix it, rather than a save that fails for no stated reason.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Two things to know before setting it. Losing it makes every
# stored connection unreadable — the rows survive and the
# secrets do not, which is the correct failure for a backup
# restored without its key. And rotating it invalidates them
# all at once: there is no re-wrap path, deliberately, because
# writing one would mean the old key and the new key living in
# the same process.
# =========================================================

NEUROLINK_SECRET_KEY=


# =========================================================
# ACTIONS
#
# The capability that lets an agent DO something between the
# question and the answer: run code it wrote, call an API, read
# the result, and decide what to do next.
#
# Every other capability is a lookup that runs once before the
# model stream begins. This one is a LOOP, and the two settings
# that bound it are the first two below.
# =========================================================

# The hard ceiling on tool calls in one turn, clamped to 1-8
# whatever is set here.
#
# The most important number in this section. Retrieval, search
# and memory are bounded structurally — their inner calls have
# every capability flag switched off, so they cannot re-enter
# themselves. That argument does not apply to a loop whose
# whole purpose is that a tool result feeds a call which may
# want another tool, so this is a real counter checked every
# iteration.
#
# Four is not arbitrary. Three covers the shapes that actually
# come up — fetch then compute, compute then check, fetch then
# fetch then combine — and the fourth is headroom for a model
# that wastes one. Past that, failures stop being "needed more
# room" and start being "stuck in a loop", and the fix for a
# loop is not a bigger budget.
NEUROLINK_ACTION_MAX_STEPS=4

# How much of one tool's output reaches the model, and how much
# all of them together may reach it in one turn.
#
# Two limits because the failure modes differ: one huge result
# is a badly chosen endpoint, four medium ones are a turn
# carrying too much. Oversized output is truncated with a
# visible marker rather than silently — a model shown a cut-off
# list with no marker reports the last item it can see as the
# last item there is.
NEUROLINK_ACTION_RESULT_CHARS=4000
NEUROLINK_ACTION_TOTAL_RESULT_CHARS=12000

# ---------------------------------------------------------
# RUNNING CODE
#
# The sandbox is four layers, and it is worth knowing which one
# does what before changing any of these.
#
#   A separate `node --permission` child, with no --allow
#   grants at all. Node's permission model denies the
#   filesystem, child processes, worker threads and native
#   addons at the runtime level. Measured on Windows, not taken
#   from the docs: all four return ERR_ACCESS_DENIED.
#
#   A vm context whose globals are built inside itself, so the
#   program has no require, no process and no fetch. This is
#   the layer that takes away the NETWORK — and it has to,
#   because Node's permission model does NOT cover the network.
#   There is no --allow-net. A --permission child with no
#   grants can still open a socket to anywhere.
#
#   The timeouts and caps below.
#
#   A stripped environment, because the permission model does
#   not hide process.env either, and this server's environment
#   is every secret it has.
#
# It is not a hypervisor. It is four cheap layers that each
# have to fail before anything interesting happens. For a
# student's agent parsing some numbers that is a sensible place
# to stop; for running untrusted code at scale it is not, and
# SandboxRunner in runJs.ts is the seam a container backend
# lands behind.
# ---------------------------------------------------------

NEUROLINK_ACTION_CODE_TIMEOUT_MS=5000
NEUROLINK_ACTION_CODE_MEMORY_MB=128
NEUROLINK_ACTION_CODE_SOURCE_CHARS=8000

# Enforced as the program prints rather than after it exits. A
# print loop would otherwise fill this server's memory long
# before any timeout fired.
NEUROLINK_ACTION_CODE_OUTPUT_BYTES=64000

# ---------------------------------------------------------
# CALLING APIS
#
# Every address is resolved and judged by the same function
# that opens the socket, so the address that was approved is by
# construction the address that is connected to. Loopback,
# private, link-local (including cloud metadata at
# 169.254.169.254), CGNAT, multicast and their IPv6 equivalents
# are all refused, and every redirect hop is re-checked.
# ---------------------------------------------------------

NEUROLINK_ACTION_HTTP_TIMEOUT_MS=10000
NEUROLINK_ACTION_HTTP_MAX_REDIRECTS=3

# Enforced while reading, not from Content-Length, which the
# far end is free to understate or omit.
NEUROLINK_ACTION_HTTP_RESPONSE_BYTES=256000
NEUROLINK_ACTION_HTTP_BODY_CHARS=8000

# Saved connections per agent. Small on purpose: this is a
# learning platform, and an agent needing fifteen credentials
# is not a lesson anybody finishes.
NEUROLINK_ACTION_MAX_CONNECTIONS=8

# Whether an agent may GET a public address it has no saved
# connection for. 0 disables it.
#
# On by default, and worth defending: off, the capability
# cannot do the thing it is most obviously for — read a public
# JSON feed — without a student first filling in a credential
# form for a service that has no credentials. The address rules
# are what make it safe, and they apply identically to a saved
# connection. A connection buys a secret and a fixed host, not
# an exemption.
NEUROLINK_ACTION_HTTP_ALLOW_PUBLIC_GET=1

# ---------------------------------------------------------
# ACTION QUOTAS
#
# Counted under the quota key `action:<power source>:<user id>`.
#
# Separate windows for the reason Web Search has them, and more
# so. A search-backed turn is three calls. An action-backed
# turn is up to nine — the answering call, then per step a tool
# execution and another model call to read its result. Charging
# all of that to the window a learner uses for the Lab would
# mean switching this on costs them everything else for a
# minute.
#
# Separate windows, not an exemption: still atomic, still
# enforced in SQL, still written to ai_usage, and still inside
# the platform budget. Tool rows report zero tokens, honestly —
# no model ran, so the request windows bound them.
# ---------------------------------------------------------

NEUROLINK_ACTION_REQUESTS_PER_MINUTE=60
NEUROLINK_ACTION_REQUESTS_PER_DAY=600
NEUROLINK_ACTION_MAX_CONCURRENT=4
NEUROLINK_ACTION_MAX_INPUT_CHARS=32000
NEUROLINK_ACTION_MAX_OUTPUT_TOKENS=1024
NEUROLINK_ACTION_TOKENS_PER_DAY=200000


# =========================================================
# EMAIL
#
# The capability that lets an agent read, triage and draft
# replies to a learner's own mailbox.
#
# READ THIS BEFORE SETTING THE THREE VARIABLES BELOW, because
# one of them cannot be obtained by filling in a form.
#
# Gmail's readonly, compose, send and modify scopes are all
# Google RESTRICTED scopes. A Cloud project using them with
# users outside the project requires OAuth verification AND an
# annual third-party security assessment. In Testing mode the
# project works for the developer and for test users added by
# hand in the Google console, which is what a development or
# pilot deployment runs on. Nothing in this codebase can
# arrange the rest.
#
# WITHOUT THESE, EVERY OTHER CAPABILITY IS UNAFFECTED. The
# connect route refuses with a message saying email is not set
# up, the Email screen says the same, and no agent is offered a
# mailbox it cannot reach.
#
# NEUROLINK_SECRET_KEY above is ALSO required: the refresh and
# access tokens are sealed with it. Without it, connecting an
# account is refused rather than storing a credential this
# server could not read back.
# ---------------------------------------------------------

# From the Google Cloud console, under APIs & Services →
# Credentials → OAuth 2.0 Client IDs → Web application.
NEUROLINK_GMAIL_CLIENT_ID=
NEUROLINK_GMAIL_CLIENT_SECRET=

# Must match a redirect URI registered on that client CHARACTER
# FOR CHARACTER, including the port. Google compares it as a
# literal string, and a mismatch produces `redirect_uri_mismatch`
# at the consent screen — before any of this server's code runs,
# so there is nothing here that can catch it or explain it.
NEUROLINK_GMAIL_REDIRECT_URI=http://localhost:3001/api/agents/email/callback

# ---------------------------------------------------------
# WHAT REACHES THE PROMPT
#
# These bound something no other block in this file does: how
# much of somebody's private correspondence is allowed to exist
# inside a single request. That is a privacy ceiling wearing a
# cost ceiling's clothes, and the two happen to point the same
# way — so the defaults are deliberately tight.
#
# A listing carries headers and a snippet, never bodies. Twelve
# of those is about 3,000 characters and enough to answer "what
# needs me this morning"; forty full bodies would not fit and
# would put most of a person's morning post into one call to a
# model provider.
# ---------------------------------------------------------

NEUROLINK_EMAIL_LIST_MAX=12
NEUROLINK_EMAIL_LIST_HARD_MAX=25
NEUROLINK_EMAIL_BODY_CHARS=4000
NEUROLINK_EMAIL_SNIPPET_CHARS=220

# ---------------------------------------------------------
# DRAFTS
#
# Two a turn, for the reason documents are capped at two: a
# turn that produced eight has misunderstood the request, and
# every one of them is something a person now has to read
# before they can clear their tray.
#
# THERE IS NO SEND SETTING HERE, and there is not going to be
# one. Sending is not something a turn does — there is no send
# tool in the catalogue — it is an authenticated POST from a
# screen a person is looking at. A variable that enabled
# automatic sending would be the one thing this capability is
# built to make impossible.
# ---------------------------------------------------------

NEUROLINK_EMAIL_MAX_DRAFTS_PER_TURN=2
NEUROLINK_EMAIL_MAX_RECIPIENTS=10
NEUROLINK_EMAIL_SUBJECT_CHARS=200
NEUROLINK_EMAIL_DRAFT_BODY_CHARS=8000

# Messages one organise call may touch. Bounded because the
# model chooses the ids, and a mistake that archives four
# hundred messages is one somebody undoes by hand.
NEUROLINK_EMAIL_MAX_ORGANIZE_IDS=20

NEUROLINK_EMAIL_TIMEOUT_MS=12000

# How early a stored access token is treated as expired. A
# token that dies between the check and the call costs the agent
# a step and the learner an action from their allowance, and the
# refresh is one cheap request.
NEUROLINK_EMAIL_REFRESH_SKEW_S=60
