  "main": "src/index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.mjs --packages=external",
    "start": "node dist/index.mjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
