    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
