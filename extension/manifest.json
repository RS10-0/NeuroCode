{
  "manifest_version": 3,
  "name": "BuildGentic",
  "version": "1.0.0",
  "description": "Chat with the agents you built on BuildGentic, from a side panel on any site.",

  "minimum_chrome_version": "116",

  "key": "",

  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "contextMenus"],

  "host_permissions": ["https://api.buildgentic.com/*"],

  "externally_connectable": {
    "matches": ["https://www.buildgentic.com/*"]
  },

  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },

  "action": {
    "default_title": "Ask your agent"
  },

  "side_panel": {
    "default_path": "panel.html"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Open the BuildGentic side panel"
    }
  },

  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
