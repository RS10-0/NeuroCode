{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "neurolink-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5199"
      ],
      "port": 5199
    },
    {
      "name": "neurolink-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "neurolink-api-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 3002,
      "env": {
        "PORT": "3002"
      }
    },
    {
      "name": "neurolink-api-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 3001,
      "env": {
        "NEUROLINK_SCHEDULER": "off",
        "NEUROLINK_SCHEDULER_TOKEN": "verify-local-token"
      }
    },
    {
      "name": "neurolink-api-alt-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 3002,
      "env": {
        "PORT": "3002",
        "NEUROLINK_SCHEDULER": "off"
      }
    },
    {
      "name": "neurolink-web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5200"
      ],
      "port": 5200,
      "env": {
        "VITE_API_TARGET": "http://localhost:3002"
      }
    }
  ]
}